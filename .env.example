# TravelFlow Environment Configuration

# Google Gemini API Key (Required for AI Trip Planner & AI Concierge)
# Get a free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Supabase Configuration (Optional - Local storage fallback is automatically enabled if not provided)
# Get your credentials at: https://supabase.com/dashboard
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Groq API Key (Legacy fallback)
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=openai/gpt-oss-120b
